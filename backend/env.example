# Copiar este archivo como .env y cambiar los valores

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicita
DB_USER=postgres
DB_PASSWORD=postgres

# Clave para firmar las sesiones: cambiarla por una frase larga propia (16 caracteres o más).
# Si se deja la del ejemplo, el sistema usa una clave temporal y las sesiones
# se cierran cada vez que se reinicia el backend.
JWT_SECRET=cambiar-esta-clave-por-una-larga

# Puerto de la API y dirección del frontend (para los enlaces del correo)
PORT=3000
FRONTEND_URL=http://localhost:5173
# Direcciones que pueden usar la API desde el navegador (separadas por coma).
# Si se deja vacío se usa FRONTEND_URL.
CORS_ORIGIN=
TZ=America/Guayaquil

# Correo para los recordatorios (RF11). Si se deja vacío, el sistema
# no envía el correo y muestra el enlace de confirmación en la consola.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediCita <no-responder@medicita.ec>"

# WhatsApp (RF16, opcional). API de WhatsApp Cloud de Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
